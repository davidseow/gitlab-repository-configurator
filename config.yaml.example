gitlab:
  url: https://gitlab.com
  token: your-personal-access-token  # Or set GITLAB_TOKEN env var
  group_id: 123

exclusions:
  # Glob patterns (fnmatch syntax)
  - "*.backup"            # Backup repositories (e.g., repo.backup, data.backup)
  - "archive-*"           # Archived repositories (e.g., archive-2023, archive-old)
  - "staging-*"           # Staging environments (e.g., staging-dev, staging-qa)
  - "test_*"              # Test repositories (e.g., test_repo, test_project)
  # Exact name matches
  - "deprecated-project"  # Exact match for repository named "deprecated-project"
  - "internal-only"       # Exact match for repository named "internal-only"

merge_request_rules:
  merge_method: rebase  # Options: rebase, ff, ff+commit
  only_allow_merge_if_all_discussions_are_resolved: true
  only_allow_merge_if_pipeline_succeeds: true
  require_approval_count: 1

slack:
  enabled: true
  webhook_url: https://hooks.slack.com/services/YOUR/WEBHOOK/URL
  notify_on_push: true
  notify_on_merge_requests: true
  notify_on_issues: false
